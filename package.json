{
	"name": "account-and-billing",
	"description": "Serverless API for account and billing",
	"version": "0.0.1",
	"private": true,
	"dependencies": {
		"@aws-sdk/client-cognito-identity-provider": "^3.635.0",
		"@aws-sdk/client-dynamodb": "^3.398.0",
		"@aws-sdk/client-kms": "^3.632.0",
		"@aws-sdk/lib-dynamodb": "^3.398.0",
		"@jigjoy-io/serverless-core": "^0.0.4",
		"@sendgrid/mail": "^8.1.5",
		"aws-jwt-verify": "^5.1.1",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@rstest/core": "^0.7.9",
		"@rstest/coverage-istanbul": "^0.1.6",
		"@types/aws-lambda": "^8.10.140",
		"@types/lodash": "^4.17.20",
		"@types/node": "^20.14.9",
		"@types/uuid": "^10.0.0",
		"dotenv": "^17.2.3",
		"esbuild": "^0.25.9",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.7.4",
		"swagger-ui-watcher": "^2.1.14",
		"ts-node": "^10.9.2",
		"typescript": "^5.5.2"
	},
	"scripts": {
		"build:local": "sam build --profile Development -t template.local.yaml ",
		"serve:local": "sam local start-api --profile Development -t .aws-sam/build/template.yaml --port 8000 --region eu-west-1 --env-vars env.json",
		"build:dev": "sam build --profile Development -t template.yaml ",
		"deploy:dev": "sam deploy --profile Development --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND",
		"docs": "npx swagger-ui-watcher openapi.yaml --port 8080",
		"test": "rstest -c rstest.config.ts",
		"coverage": "rstest --coverage",
		"format": "prettier --write \"src/**/*.{ts,tsx}\""
	}
}
