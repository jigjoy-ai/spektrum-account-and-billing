{
    "name": "puzzle-box-serverless",
    "description": "Serverless API for creating web applications from textual prompts",
    "version": "0.0.1",
    "private": true,
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.398.0",
        "@aws-sdk/lib-dynamodb": "^3.398.0",
        "@langchain/community": "^0.3.22",
        "@langchain/core": "^0.3.27",
        "@langchain/langgraph": "^0.2.39",
        "@langchain/openai": "^0.3.16",
        "ajv": "^8.16.0",
        "ajv-formats": "^3.0.1",
        "esbuild": "^0.21.5",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.140",
        "@types/node": "^20.14.9",
        "@types/uuid": "^10.0.0",
        "aws-sdk-client-mock": "^2.0.0",
        "jest": "^29.2.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.2"
    },
    "scripts": {
        "build": "sam build --profile Development",
        "deploy": "sam deploy --profile Development",
        "serve": "sam local start-api --profile Development --port 8000 --region eu-west-1 --env-vars env.json",
        "start": "sam local start-api --profile Development --port 8000 --region eu-west-1 --env-vars env.json",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "format": "prettier --write \"{src,packages}/**/*.{ts,tsx}\""
    },
    "jest": {
        "testMatch": [
            "**/__tests__/**/*.[jt]s?(x)",
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/__tests__/**/*.mjs?(x)",
            "**/?(*.)+(spec|test).mjs?(x)"
        ],
        "moduleFileExtensions": [
            "mjs",
            "js"
        ]
    }
}
