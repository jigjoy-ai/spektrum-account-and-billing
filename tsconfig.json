{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["es2020"],
      "declaration": true,
      "strict": true,
      "noImplicitAny": true,
      "strictNullChecks": true,
      "noImplicitThis": true,
      "alwaysStrict": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": false,
      "inlineSourceMap": true,
      "inlineSources": true,
      "experimentalDecorators": true,
      "strictPropertyInitialization": false,
      "typeRoots": ["./node_modules/@types"],
      "baseUrl": ".",
      "paths": {
        "@adapters/*": ["./src/project/adapters/*"],
        "@auth/*": ["./src/project/auth/*"],
        "@domain/*": ["./src/project/domain/*"],
        "@dto/*": ["./src/project/dto/*"],
        "@entity/*": ["./src/project/entity/*"],
        "@errors/*": ["./src/project/errors/*"],
        "@repositories/*": ["./src/project/repositories/*"],
        "@schemas/*": ["./src/project/schemas/*"],
        "@models/*": ["./src/project/models/*"],
        "@use-cases/*": ["./src/project/use-cases/*"],
        "@utils/*": ["./src/utils/*"],
        "@packages/*": ["./packages/*"],
      }
    },
    "exclude": ["node_modules", "**/*.test.ts"]
  }