{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["es2020"],
      "declaration": true,
      "strict": true,
      "noImplicitAny": true,
      "strictNullChecks": true,
      "noImplicitThis": true,
      "alwaysStrict": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": false,
      "inlineSourceMap": true,
      "inlineSources": true,
      "experimentalDecorators": true,
      "strictPropertyInitialization": false,
      "typeRoots": ["./node_modules/@types"],
      "baseUrl": ".",
      "paths": {
        "@adapters/*": ["./src/project-management/adapters/*"],
        "@auth/*": ["./src/project-management/auth/*"],
        "@domain/*": ["./src/project-management/domain/*"],
        "@dto/*": ["./src/project-management/dto/*"],
        "@entity/*": ["./src/project-management/entity/*"],
        "@errors/*": ["./src/project-management/errors/*"],
        "@repositories/*": ["./src/project-management/repositories/*"],
        "@schemas/*": ["./src/project-management/schemas/*"],
        "@models/*": ["./src/project-management/models/*"],
        "@use-cases/*": ["./src/project-management/use-cases/*"],
        "@utils/*": ["./src/utils/*"],
        "@packages/*": ["./packages/*"],
      }
    },
    "exclude": ["node_modules", "**/*.test.ts"]
  }